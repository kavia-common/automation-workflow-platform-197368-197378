# Example environment variables for rpa_backend

# Database connection URL (default is SQLite local file)
DATABASE_URL=sqlite:///./rpa.db

# JWT secret for signing tokens (use a strong random string in production)
JWT_SECRET=change-me-in-production

# Comma-separated CORS origins (e.g., http://localhost:3000,https://yourdomain.com)
CORS_ORIGINS=http://localhost:3000
